{
  "name": "mapa-tierras-gosen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:public": "node scripts/prepare-public.mjs",
    "predev": "npm run prepare:public",
    "dev": "vinext dev",
    "prebuild": "npm run prepare:public",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "check": "node --check js/map.js && node --check js/filters.js && node scripts/validate-content.mjs && node --test && tsc --noEmit && npm run build",
    "test": "node --test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.475.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.92.0"
  }
}
